ASSET_TYPE=equity
SYMBOL=InFy
TIMEFRAME=1d
PERIOD=5y

# Timeframe	        Max lookback (free, Yahoo)
# 1m	            7 days
# 5m, 15m, 30m	    >60 days
# 1h	            ?730 days (2 years)
# 4h	            >730 days (built by combining 1h candles — Yahoo has no native 4h)
# 1d	            unlimited

# TIMEFRAME accepts: 1m, 5m, 15m, 30m, 1h, 4h, 1d
# PERIOD accepts: 7d, 60d, 2y, 5y, 10y, max, etc.

# For equity:
# ASSET_TYPE=equity
# SYMBOL=TCS
# TIMEFRAME=1d
# PERIOD=5y

# For futures:
# ASSET_TYPE=futures
# SYMBOL=TCS
# FROM_DATE=01-01-2024
# TO_DATE=31-01-2024
# EXPIRY=25-Jan-2024

# For options:
# ASSET_TYPE=options
# SYMBOL=TCS
# FROM_DATE=01-01-2024
# TO_DATE=31-01-2024
# EXPIRY=25-Jan-2024
# STRIKE=3800
# OPTION_TYPE=CE

